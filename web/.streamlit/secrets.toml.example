# Copie ce fichier en secrets.toml UNIQUEMENT pour un déploiement Streamlit
# Community Cloud. En local, l'app lit déjà config/.env — ce fichier n'est
# pas nécessaire pour `streamlit run`.
#
# secrets.toml ne doit JAMAIS être commité (il est dans .gitignore).

DATABASE_URL = "postgresql://user:password@host/db?sslmode=require"
